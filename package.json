{
    "name": "worktime",
    "version": "0.10.1",
    "description": "Nextcloud App zur Arbeitszeiterfassung",
    "main": "src/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build && rm -rf js css && mkdir -p js css && cp -r dist/js/* js/ && cp -r dist/css/* css/",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests/frontend",
        "lint:fix": "eslint src tests/frontend --fix",
        "l10n:check": "nc-l10n-check",
        "l10n:fix": "nc-l10n-check --fix",
        "whatsnew:check": "nc-whatsnew-check",
        "design:check": "nc-design-check",
        "timezone:check": "nc-timezone-check",
        "prepare": "git config core.hooksPath .githooks || true"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cpcMomentum/worktime.git"
    },
    "keywords": [
        "nextcloud",
        "app",
        "worktime",
        "time-tracking"
    ],
    "author": "cpcMomentum GmbH",
    "license": "AGPL-3.0-or-later",
    "dependencies": {
        "@nextcloud/axios": "^2.6.0",
        "@nextcloud/dialogs": "^7.6.0",
        "@nextcloud/initial-state": "^3.0.0",
        "@nextcloud/l10n": "^3.4.1",
        "@nextcloud/router": "^3.2.0",
        "@nextcloud/vue": "^9.14.1",
        "pinia": "^4.1.0",
        "vue": "^3.5.42",
        "vue-material-design-icons": "^5.4.0",
        "vue-router": "^5.3.0"
    },
    "devDependencies": {
        "@nextcloud/eslint-config": "^9.0.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "happy-dom": "^21.0.4",
        "nc-app-tooling": "github:cpcMomentum/nc-app-tooling#v1.23.0",
        "typescript": "^5.7.2",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
    },
    "type": "module"
}
